.front
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url("/assets/images/global/_linked/hero.jpg")
    background-size: cover
    background-position: center
    scroll-margin-top: rem(84px)
    .content
        display: flex
        flex-direction: column
        align-items: center
        justify-content: center
        width: 100%
        padding: rem(96px) 20px rem(60px)
        text-align: center
        +min(2)
            margin-top: -20px
        .hero-logo
            display: block
            width: 100%
            max-width: rem(280px)
            height: auto
            margin: 0 auto rem(26px)
            +min(2)
                max-width: rem(360px)
        .contactButton
            width: 100%
            display: flex
            flex-direction: column
            align-items: center
            justify-content: center
            margin: 0 auto
        h1
            display: block
            width: 100%
            max-width: 850px
            font-size: 1.6rem
            font-weight: 700
            color: #fff
            text-align: center
            margin: 10px auto 25px
            text-transform: uppercase
            letter-spacing: 2px
            text-shadow: 2px 2px 10px rgba(0,0,0,0.8)
            line-height: 1.2
            +min(1)
                font-size: 2.5rem
            +min(2)
                font-size: 3.2rem
        div
            display: flex
            flex-direction: column
            align-items: center
            justify-content: center
            width: 100%
            div
                display: flex
                flex-direction: column
                align-items: center
                justify-content: center
                width: 100%
                +min(1)
                    flex-direction: row
                    width: auto
                a
                    button(large, color: #213e9a)
                    margin: rem(8px) 0
                    min-width: 60%
                    background: #213e9a
                    color: #fff
                    font-weight: 700
                    border: none
                    border-radius: 50px
                    transition: all 0.3s ease
                    &:hover
                        background: #fff
                        color: #213e9a
                        transform: scale(1.05)
                    +min(1)
                        min-width: auto
                        font-size: 1.2rem
                        margin: 0
                        padding: rem(16px) rem(40px)
                    +min(2)
                        font-size: 1.25rem
                        padding: rem(17px) rem(45px)
                    +min(3)
                        font-size: 1.4rem
                        padding: rem(20px) rem(50px)
    .content
        .contactButton
            .eyebrow
                color: #bcd0ff
                font-weight: 700
                letter-spacing: 3px
                text-transform: uppercase
                font-size: 0.85rem
                margin: 0 0 5px
                +min(1)
                    font-size: 1rem
            .hero-sub
                color: #fff
                max-width: 720px
                font-size: 1.15rem
                line-height: 1.6
                margin: 0 auto 30px
                text-shadow: 1px 1px 6px rgba(0,0,0,0.8)
                strong
                    font-weight: 700
                +min(1)
                    font-size: 1.3rem
            .cta-row
                gap: 16px
                a.btn-secondary
                    background: transparent
                    border: 2px solid #fff
                    &:hover
                        background: #fff
                        color: #213e9a
                        transform: scale(1.05)
            a.hero-tools
                color: #fff
                font-weight: 600
                font-size: 1.05rem
                margin-top: 24px
                text-decoration: underline
                text-underline-offset: 4px
                &:hover
                    color: #bcd0ff
            .hero-proof
                color: rgba(255,255,255,0.85)
                font-size: 0.95rem
                max-width: 760px
                margin: 26px auto 0
                line-height: 1.7
            .hero-links
                color: rgba(255,255,255,0.9)
                font-size: 1rem
                margin: 14px auto 0
                a
                    color: #fff
                    font-weight: 600
                    text-decoration: underline
                    text-underline-offset: 3px
                    &:hover
                        color: #bcd0ff
                span
                    margin: 0 8px
