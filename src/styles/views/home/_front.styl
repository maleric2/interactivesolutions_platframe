.front
    background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url("/assets/images/_sprites/pexels-designdrunkard-4158594.jpg")
    background-size: cover
    background-position: center
    .content
        display: flex
        flex-direction: column
        align-items: center
        justify-content: center
        width: 100%
        padding: 60px 20px
        text-align: center
        +min(2)
            margin-top: -20px
        .contactButton
            width: 100%
            display: flex
            flex-direction: column
            align-items: center
            justify-content: center
            margin: 0 auto
        h1
            display: block
            width: 100%
            max-width: 850px
            font-size: 1.6rem
            font-weight: 700
            color: #fff
            text-align: center
            margin: 10px auto 25px
            text-transform: uppercase
            letter-spacing: 2px
            text-shadow: 2px 2px 10px rgba(0,0,0,0.8)
            line-height: 1.2
            +min(1)
                font-size: 2.5rem
            +min(2)
                font-size: 3.2rem
        div
            display: flex
            flex-direction: column
            align-items: center
            justify-content: center
            width: 100%
            div
                display: flex
                flex-direction: column
                align-items: center
                justify-content: center
                width: 100%
                +min(1)
                    flex-direction: row
                    width: auto
                a
                    button(large, color: #213e9a)
                    margin: rem(8px) 0
                    min-width: 60%
                    background: #213e9a
                    color: #fff
                    font-weight: 700
                    border: none
                    border-radius: 50px
                    transition: all 0.3s ease
                    &:hover
                        background: #fff
                        color: #213e9a
                        transform: scale(1.05)
                    +min(1)
                        min-width: auto
                        font-size: 1.2rem
                        margin: 0
                        padding: rem(16px) rem(40px)
                    +min(2)
                        font-size: 1.25rem
                        padding: rem(17px) rem(45px)
                    +min(3)
                        font-size: 1.4rem
                        padding: rem(20px) rem(50px)
