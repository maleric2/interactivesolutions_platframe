.front
    position: relative
    background: _c_cinema
    overflow: hidden

    // Scene layers. The hero is fully readable without any of this; the layers
    // only add depth when motion is allowed and JavaScript is available.
    .hero-scene
        position: absolute
        inset: 0
        pointer-events: none

    .hero-parallax
        position: absolute
        inset: 0
        will-change: transform

    .hero-bg
        position: absolute
        inset: -4%
        background: url("/assets/images/global/_linked/hero.jpg") center / cover no-repeat
        transform: scale(1.04)
        animation: hero-drift 30s ease-in-out infinite alternate

    // directional overlay keeps left-side text legible while the render shows through
    .hero-veil
        position: absolute
        inset: 0
        background: linear-gradient(90deg, rgba(5, 8, 15, 0.96) 0%, rgba(5, 8, 15, 0.86) 34%, rgba(5, 8, 15, 0.38) 68%, rgba(5, 8, 15, 0.6) 100%), radial-gradient(130% 100% at 74% 46%, rgba(5, 8, 15, 0) 36%, rgba(5, 8, 15, 0.75) 100%)

    .hero-glow
        position: absolute
        inset: -12%
        background: radial-gradient(36% 44% at 66% 42%, rgba(95, 124, 240, 0.36), rgba(95, 124, 240, 0) 72%), radial-gradient(24% 30% at 30% 68%, rgba(53, 200, 189, 0.16), rgba(53, 200, 189, 0) 70%)
        will-change: transform
        animation: hero-breathe 9s ease-in-out infinite alternate

    .hero-particles
        position: absolute
        inset: 0
        overflow: hidden
        span
            position: absolute
            border-radius: 50%
            background: rgba(157, 180, 255, 0.9)
            animation-name: hero-float
            animation-timing-function: ease-in-out
            animation-direction: alternate
            animation-iteration-count: infinite

    .hero-content
        position: relative
        z-index: 1
        display: flex
        flex-direction: column
        align-items: flex-start
        width: 100%
        max-width: _w_wide
        margin: 0 auto
        padding: rem(140px) _pad_x rem(100px)
        text-align: left

    .section-eyebrow
        margin: 0 0 rem(20px)

    .hero-title
        max-width: rem(880px)
        margin: 0 0 rem(24px)
        color: #fff
        font-size: rem(38px)
        font-weight: 700
        line-height: 1.06
        letter-spacing: -1.2px
        text-shadow: 0 6px 30px rgba(0, 0, 0, 0.55)
        +min(1)
            font-size: rem(54px)
        +min(2)
            font-size: rem(68px)

    .hero-sub
        max-width: rem(650px)
        margin: 0 0 rem(38px)
        color: _c_text_soft
        font-size: rem(16px)
        line-height: 1.8
        strong
            color: #fff
        +min(1)
            font-size: rem(18px)

    .hero-actions
        display: flex
        flex-direction: column
        align-items: stretch
        gap: rem(14px)
        width: 100%
        max-width: rem(320px)
        +min(1)
            flex-direction: row
            align-items: center
            width: auto
            max-width: none
        .btn
            width: 100%
            +min(1)
                width: auto

    .hero-recruiter
        margin: rem(28px) 0 0
        color: _c_text_muted
        font-size: rem(14px)
        a
            color: _c_accent_pale