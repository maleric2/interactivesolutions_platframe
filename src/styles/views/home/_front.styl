.front
    position: relative
    background: _c_cinema
    overflow: hidden

    .hero-bg
        position: absolute
        inset: 0
        background: url("/assets/images/global/_linked/hero.jpg") center / cover no-repeat
        opacity: 0.55

    &::after
        position: absolute
        inset: 0
        background: linear-gradient(180deg, rgba(5, 8, 15, 0.86) 0%, rgba(5, 8, 15, 0.5) 44%, _c_cinema 100%)
        content: ''

    .hero-content
        position: relative
        z-index: 1
        display: flex
        flex-direction: column
        align-items: center
        justify-content: center
        width: 100%
        padding: rem(132px) _pad_x rem(96px)
        text-align: center

    .hero-logo
        display: block
        width: 100%
        max-width: rem(250px)
        height: auto
        margin: 0 auto rem(24px)
        +min(2)
            max-width: rem(320px)

    .section-eyebrow
        margin: 0 0 rem(16px)

    .hero-title
        max-width: rem(920px)
        margin: 0 auto rem(22px)
        color: #fff
        font-size: rem(36px)
        font-weight: 700
        line-height: 1.06
        letter-spacing: -1.2px
        text-shadow: 0 6px 30px rgba(0, 0, 0, 0.65)
        +min(1)
            font-size: rem(52px)
        +min(2)
            font-size: rem(66px)

    .hero-sub
        max-width: rem(680px)
        margin: 0 auto rem(36px)
        color: _c_text_soft
        font-size: rem(16px)
        line-height: 1.78
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.6)
        strong
            color: #fff
        +min(1)
            font-size: rem(18px)

    .hero-actions
        display: flex
        flex-direction: column
        align-items: stretch
        gap: rem(14px)
        width: 100%
        max-width: rem(320px)
        +min(1)
            flex-direction: row
            justify-content: center
            align-items: center
            max-width: none
            width: auto
        .btn
            width: 100%
            +min(1)
                width: auto

    .hero-tools
        margin-top: rem(26px)
        color: #fff
        font-size: rem(15px)
        font-weight: 600
        text-decoration: underline
        text-underline-offset: 4px
        &:hover, &:focus, &:active
            color: _c_accent_pale

    .hero-proof
        margin: rem(32px) auto 0
        max-width: rem(780px)
        color: rgba(238, 241, 250, 0.76)
        font-size: rem(14px)
        line-height: 1.85
        letter-spacing: 0.2px

    .hero-links
        margin: rem(16px) auto 0
        color: rgba(238, 241, 250, 0.78)
        font-size: rem(14px)
        a
            color: #fff
            font-weight: 600
            text-decoration: underline
            text-underline-offset: 3px
            &:hover, &:focus, &:active
                color: _c_accent_pale
        span
            margin: 0 rem(9px)