.experience
    background: linear-gradient(135deg, #242f657d 0%, #213f9a7d 100%), url("https://images.unsplash.com/photo-1523050335392-93851179ae22?auto=format&fit=crop&q=80&w=2070")
    
    color: #fff
    .content
        padding: 100px 20px
        +min(1)
            padding: 120px 0
        > div:first-of-type
            width: 100%
            max-width: 1200px
            margin: 0 auto
            display: flex
            flex-direction: column
            align-items: center
            +min(2)
                flex-direction: row
            .section-logo
                width: 60%
                filter: brightness(0) invert(1)
                margin-bottom: 30px
                +min(1)
                    width: 40%
                +min(2)
                    width: 30%
                    margin: 0 65px 0 0
            article
                text-align: center
                +min(2)
                    text-align: left
                    flex: 1
                h2
                    color: #fff
                    font-size: 2.5rem
                    margin-bottom: 20px
                    +min(1)
                        font-size: 3.5rem
                p
                    font-size: 1.3rem
                    line-height: 1.6
                    color: rgba(255, 255, 255, 0.9)
                    +min(1)
                        font-size: 1.9rem
                    +min(2)
                        font-size: 1.7rem
                    +min(3)
                        font-size: 1.8rem
                    strong
                        color: #fff
                        font-weight: 700

    .section-cta
        text-align: center
        margin-top: 60px
        padding: 40px 20px
        background: rgba(33, 62, 154, 0.3)
        border-radius: 20px
        border: 1px solid rgba(255,255,255,0.2)
        p
            font-size: 1.5rem
            color: #fff
            margin: 0 0 20px
            font-weight: 500
        .cta-button
            display: inline-block
            padding: 18px 40px
            background: #fff
            color: #242F65
            text-decoration: none
            border-radius: 50px
            font-size: 1.3rem
            font-weight: 700
            transition: transform 0.3s ease, box-shadow 0.3s ease
            &:hover
                transform: translateY(-5px)
                box-shadow: 0 15px 30px rgba(0,0,0,0.3)