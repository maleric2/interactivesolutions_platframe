// generic
.home
    background: url("images/home/front/_inline/pexels-designdrunkard-4158594.jpg")
    background-size: cover;
    background-position: center;

    .margin15
        margin: 0 auto 20px
        max-width: 95%
        height: auto
        display: block
        +min(1)
            max-width: 80%
            margin: 0 auto 30px
        +min(2)
            max-width: 850px
            margin: 0 auto 40px

    .canvas
        min-height: 100vh
        position: relative
        display: flex
        flex-direction: column
        align-items: center
        &:not(.front) .content
            padding: 100px 20px 40px
            flex: 1
            +min(1)
                padding: 120px 0 60px
        
        h2
            color: #fff !important
            text-shadow: 0 4px 15px rgba(0,0,0,0.5) !important
            opacity: 1 !important

        &:not(:first-of-type)
            border-top: none
            & > h2:first-of-type
                flex: 0 0 auto
                position: absolute
                top: 0
                left: 50%
                width: auto
                min-width: 280px
                max-width: 90%
                margin: 0
                padding: 12px 20px
                color: #fff
                font-size: 1.1em
                text-align: center
                font-weight: 700
                letter-spacing: 3px
                text-transform: uppercase
                border-radius: 0 0 10px 10px
                transform: translateX(-50%)
                background: rgba(33, 62, 154, 0.9)
                border: 1px solid rgba(255,255,255,0.1)
                border-top: none
                box-shadow: 0 4px 10px rgba(0,0,0,0.3)
                z-index: 10
                +min(1)
                    min-width: 400px
                +min(2)
                    min-width: 500px
        
        +nav-1()
            display: block
            margin: 30px auto 0
            position: relative
            left: auto
            bottom: auto
            transform: none
            width: 50px
            height: 50px
            background: rgba(255, 255, 255, 0.2)
            border: 2px solid rgba(255, 255, 255, 0.4)
            border-radius: 50%
            transition: all 0.3s ease
            &:hover
                background: rgba(255, 255, 255, 0.3)
                transform: scale(1.1)
            button
                background: transparent !important
                border: none !important
                padding: 0
                margin: 0
                width: 100%
                height: 100%
                display: flex
                align-items: center
                justify-content: center
            svg
                fill: #fff !important
                width: 24px !important
                height: 24px !important
                margin: 0 !important

    .section-cta
        padding: 40px 20px 100px
        text-align: center
        width: 100%
        background: none !important
        border: none !important
        box-shadow: none !important
        p
            font-size: 1.4rem
            color: #fff
            margin: 0 0 30px 0 !important
            padding: 0 !important
            font-weight: 600
            text-shadow: 1px 1px 4px rgba(0,0,0,0.5)
            background: none !important
            border: none !important
        .cta-button
            display: inline-block
            padding: 18px 45px
            background: #213e9a
            color: #fff
            text-decoration: none
            border-radius: 50px
            font-weight: 700
            font-size: 1.3rem
            transition: all 0.3s ease
            border: none !important
            box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important
            outline: none !important
            &:hover
                background: #fff
                color: #213e9a
                transform: translateY(-5px)
                box-shadow: 0 15px 30px rgba(0,0,0,0.4) !important

    .section-logo
        max-width: 200px
        height: auto
        margin-bottom: 20px
        filter: brightness(0) invert(1)
        +min(2)
            max-width: 300px

    // partials
    @require '_front'
    @require '_section-1'
    @require '_games'
    @require '_interactive-apps'
    @require '_consulting'
