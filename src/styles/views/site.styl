/*━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━  SITE  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
┃ Shared building blocks used across the homepage and all subpages.  ┃
┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━*/

// utilities ─────────────────────────────────────────────────────────

.visually-hidden
    position: absolute
    width: 1px
    height: 1px
    margin: -1px
    padding: 0
    overflow: hidden
    clip: rect(0 0 0 0)
    white-space: nowrap
    border: 0

.skip-link
    position: absolute
    top: -60px
    left: 12px
    z-index: 200
    padding: 10px 18px
    color: #fff
    background: #213e9a
    border-radius: 0 0 8px 8px
    font-weight: 700
    text-decoration: none
    transition: top 0.2s ease
    &:focus
        top: 0

// dark page shell for subpages ──────────────────────────────────────

.page
    color: #e9edf7
    background: #0f1530

    h1, h2, h3, h4
        color: #fff

// header ────────────────────────────────────────────────────────────

.site-header
    position: sticky
    top: 0
    z-index: 100
    width: 100%
    background: rgba(12, 18, 40, 0.88)
    border-bottom: 1px solid rgba(255, 255, 255, 0.08)
    backdrop-filter: blur(12px)

.site-header-inner
    position: relative
    display: flex
    align-items: center
    justify-content: space-between
    gap: rem(16px)
    width: 100%
    max-width: 1120px
    margin: 0 auto
    padding: rem(12px) rem(20px)

.site-brand
    display: flex
    align-items: center
    gap: rem(10px)
    color: #fff
    font-weight: 700
    text-decoration: none
    white-space: nowrap

.site-brand-mark
    display: inline-flex
    align-items: center
    justify-content: center
    width: rem(34px)
    height: rem(34px)
    color: #fff
    background: #213e9a
    border-radius: rem(8px)
    font-size: rem(14px)
    letter-spacing: 1px

.site-brand-text
    font-size: rem(15px)
    letter-spacing: 0.4px
    +max(1)
        display: none

.site-nav
    ul
        display: flex
        align-items: center
        gap: rem(6px)
        margin: 0
        padding: 0
        list-style: none
    a
        display: inline-block
        padding: rem(8px) rem(12px)
        color: rgba(255, 255, 255, 0.82)
        font-size: rem(14px)
        font-weight: 600
        text-decoration: none
        border-radius: rem(6px)
        &:hover, &:focus, &:active
            color: #fff
            background: rgba(255, 255, 255, 0.08)

.site-header-cta
    display: inline-block
    padding: rem(9px) rem(18px)
    color: #fff
    background: #213e9a
    border-radius: 50px
    font-size: rem(14px)
    font-weight: 700
    text-decoration: none
    white-space: nowrap
    transition: background 0.2s ease, color 0.2s ease
    &:hover, &:focus, &:active
        color: #213e9a
        background: #fff

.nav-toggle
    position: absolute
    width: 1px
    height: 1px
    opacity: 0
    pointer-events: none

.nav-toggle-label
    display: none
    width: rem(42px)
    height: rem(42px)
    align-items: center
    justify-content: center
    cursor: pointer
    border: 1px solid rgba(255, 255, 255, 0.25)
    border-radius: rem(8px)

.nav-toggle-bars
    position: relative
    display: block
    width: rem(20px)
    height: 2px
    background: #fff
    &::before, &::after
        position: absolute
        left: 0
        width: 100%
        height: 2px
        background: #fff
        content: ''
    &::before
        top: -6px
    &::after
        top: 6px

.nav-toggle:focus-visible ~ .nav-toggle-label
    outline: 2px solid #fff
    outline-offset: 2px

+max(2)
    .nav-toggle-label
        display: inline-flex

    .site-nav
        display: none
        position: absolute
        top: 100%
        left: 0
        width: 100%
        padding: rem(8px) rem(20px) rem(16px)
        background: rgba(12, 18, 40, 0.98)
        border-bottom: 1px solid rgba(255, 255, 255, 0.08)
        ul
            flex-direction: column
            align-items: stretch
            gap: 0
        a
            display: block
            padding: rem(12px) rem(4px)
            border-bottom: 1px solid rgba(255, 255, 255, 0.07)

    .nav-toggle:checked ~ .site-nav
        display: block

    .site-header-cta
        display: none

// desktop: the menu toggle is not rendered, so remove it from the tab order
+min(2)
    .nav-toggle
        display: none

// sections ─────────────────────────────────────────────────────────

.page-section
    width: 100%
    padding: rem(72px) 0
    border-top: 1px solid rgba(255, 255, 255, 0.07)
    scroll-margin-top: rem(84px)
    +min(2)
        padding: rem(96px) 0

.section-inner
    width: 100%
    max-width: 1120px
    margin: 0 auto
    padding: 0 rem(20px)

.section-eyebrow
    margin: 0 0 rem(10px)
    color: #8ea9ff
    font-size: rem(13px)
    font-weight: 700
    letter-spacing: 3px
    text-transform: uppercase

.section-title
    margin: 0 0 rem(14px)
    color: #fff
    font-size: rem(28px)
    font-weight: 700
    line-height: 1.2
    +min(2)
        font-size: rem(40px)

.section-lead
    max-width: 720px
    margin: 0 0 rem(36px)
    color: rgba(233, 237, 247, 0.82)
    font-size: rem(17px)
    line-height: 1.7

// cards ─────────────────────────────────────────────────────────────

.card-grid
    display: grid
    grid-template-columns: 1fr
    gap: rem(24px)
    +min(1)
        grid-template-columns: repeat(2, 1fr)
    +min(2)
        grid-template-columns: repeat(4, 1fr)

.card
    display: flex
    flex-direction: column
    padding: rem(26px)
    background: rgba(255, 255, 255, 0.045)
    border: 1px solid rgba(255, 255, 255, 0.1)
    border-radius: rem(16px)

.card-title
    margin: 0 0 rem(10px)
    color: #fff
    font-size: rem(19px)
    font-weight: 700
    line-height: 1.3

.card-text
    margin: 0 0 rem(18px)
    color: rgba(233, 237, 247, 0.82)
    font-size: rem(15px)
    line-height: 1.65

.tag-list
    display: flex
    flex-wrap: wrap
    gap: rem(8px)
    margin: auto 0 0
    padding: 0
    list-style: none

.tag
    padding: rem(4px) rem(10px)
    color: #bcd0ff
    background: rgba(33, 62, 154, 0.35)
    border: 1px solid rgba(142, 169, 255, 0.28)
    border-radius: 50px
    font-size: rem(12px)
    font-weight: 600

// work cards ────────────────────────────────────────────────────────

.work-grid
    display: grid
    grid-template-columns: 1fr
    gap: rem(24px)
    +min(2)
        grid-template-columns: repeat(3, 1fr)

.work-card
    padding: 0
    overflow: hidden

.card-figure
    width: 100%
    height: rem(190px)
    margin: 0
    overflow: hidden
    img
        display: block
        width: 100%
        height: 100%
        object-fit: cover

.card-body
    display: flex
    flex: 1
    flex-direction: column
    padding: rem(24px)

.card-kicker
    margin: 0 0 rem(8px)
    color: #8ea9ff
    font-size: rem(12px)
    font-weight: 700
    letter-spacing: 2px
    text-transform: uppercase

.card-link
    margin-top: rem(16px)
    color: #fff
    font-size: rem(14px)
    font-weight: 700
    text-decoration: underline
    text-underline-offset: 3px
    &:hover, &:focus, &:active
        color: #bcd0ff

// tools ─────────────────────────────────────────────────────────────

.tools-grid
    display: grid
    grid-template-columns: 1fr
    gap: rem(24px)
    +min(2)
        grid-template-columns: 3fr 2fr

.tool-card
    padding: rem(30px)

.tool-badge
    display: inline-block
    margin: 0 0 rem(14px)
    padding: rem(4px) rem(12px)
    color: #d7ffd9
    background: rgba(38, 128, 62, 0.35)
    border: 1px solid rgba(120, 220, 150, 0.35)
    border-radius: 50px
    font-size: rem(12px)
    font-weight: 700
    letter-spacing: 1px
    text-transform: uppercase

.tool-badge-soon
    color: #ffe6bd
    background: rgba(150, 105, 20, 0.3)
    border-color: rgba(240, 190, 100, 0.35)

.tool-actions
    display: flex
    flex-wrap: wrap
    gap: rem(12px)
    margin-top: rem(20px)

// buttons ───────────────────────────────────────────────────────────

.btn
    display: inline-block
    padding: rem(14px) rem(30px)
    border-radius: 50px
    font-size: rem(15px)
    font-weight: 700
    text-align: center
    text-decoration: none
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease

.btn-primary
    color: #fff
    background: #213e9a
    &:hover, &:focus, &:active
        color: #213e9a
        background: #fff
        transform: translateY(-2px)

.btn-secondary
    color: #fff
    background: transparent
    border: 2px solid rgba(255, 255, 255, 0.55)
    &:hover, &:focus, &:active
        color: #213e9a
        background: #fff
        transform: translateY(-2px)

.btn-ghost
    color: #bcd0ff
    background: rgba(33, 62, 154, 0.25)
    border: 1px solid rgba(142, 169, 255, 0.35)
    &:hover, &:focus, &:active
        color: #fff
        background: rgba(33, 62, 154, 0.5)

.section-actions
    display: flex
    flex-wrap: wrap
    gap: rem(14px)
    margin-top: rem(32px)

// about ─────────────────────────────────────────────────────────────

.about-grid
    display: grid
    grid-template-columns: 1fr
    gap: rem(32px)
    +min(2)
        grid-template-columns: 1fr 2fr

.about-body
    p
        margin: 0 0 rem(18px)
        color: rgba(233, 237, 247, 0.85)
        font-size: rem(16px)
        line-height: 1.75

.proof-list
    display: grid
    grid-template-columns: 1fr
    gap: rem(10px)
    margin: rem(24px) 0 0
    padding: 0
    list-style: none
    +min(1)
        grid-template-columns: repeat(2, 1fr)
    li
        position: relative
        margin: 0
        padding: 0 0 0 rem(26px)
        color: rgba(233, 237, 247, 0.88)
        font-size: rem(15px)
        line-height: 1.6
        &::before
            position: absolute
            left: 0
            color: #6fd48a
            font-weight: 700
            content: '\2713'

.availability
    margin-top: rem(28px)
    padding: rem(22px)
    background: rgba(33, 62, 154, 0.22)
    border: 1px solid rgba(142, 169, 255, 0.25)
    border-radius: rem(14px)
    h3
        margin: 0 0 rem(12px)
        font-size: rem(17px)
    ul
        margin: 0
        padding: 0
        list-style: none
        li
            margin: 0 0 rem(8px)
            padding-left: rem(18px)
            color: rgba(233, 237, 247, 0.85)
            font-size: rem(15px)
            line-height: 1.6
            &::before
                margin-left: rem(-18px)
                margin-right: rem(8px)
                color: #8ea9ff
                content: '\2013'

// callout ───────────────────────────────────────────────────────────

.callout
    margin-top: rem(28px)
    padding: rem(22px)
    background: rgba(255, 255, 255, 0.05)
    border-left: 4px solid #213e9a
    border-radius: 0 rem(12px) rem(12px) 0

.callout-title
    margin: 0 0 rem(8px)
    font-size: rem(16px)

.callout-text
    margin: 0
    color: rgba(233, 237, 247, 0.85)
    font-size: rem(15px)
    line-height: 1.65

// cta band ──────────────────────────────────────────────────────────

.cta-band
    display: flex
    flex-direction: column
    align-items: flex-start
    gap: rem(18px)
    margin-top: rem(36px)
    padding: rem(30px)
    background: rgba(33, 62, 154, 0.3)
    border: 1px solid rgba(255, 255, 255, 0.16)
    border-radius: rem(18px)
    +min(1)
        flex-direction: row
        align-items: center
        justify-content: space-between

.cta-band-lead
    margin: 0
    color: #fff
    font-size: rem(18px)
    font-weight: 600

// subpage hero ──────────────────────────────────────────────────────

.page-hero
    padding: rem(64px) 0 rem(40px)
    +min(2)
        padding: rem(96px) 0 rem(56px)

.page-hero-inner
    width: 100%
    max-width: 1120px
    margin: 0 auto
    padding: 0 rem(20px)
    h1
        max-width: 900px
        margin: 0 0 rem(16px)
        color: #fff
        font-size: rem(30px)
        font-weight: 700
        line-height: 1.18
        +min(2)
            font-size: rem(46px)
    p
        max-width: 720px
        margin: 0
        color: rgba(233, 237, 247, 0.85)
        font-size: rem(17px)
        line-height: 1.7

.breadcrumbs
    margin: 0 0 rem(18px)
    padding: 0
    list-style: none
    li
        display: inline-block
        margin: 0
        color: rgba(233, 237, 247, 0.6)
        font-size: rem(13px)
        &::after
            margin: 0 rem(8px)
            content: '/'
        &:last-child
            &::after
                content: ''
    a
        color: #bcd0ff
        text-decoration: none
        &:hover, &:focus, &:active
            text-decoration: underline

// prose (case studies, legal) ───────────────────────────────────────

.prose
    max-width: 760px
    h2
        margin: rem(36px) 0 rem(12px)
        color: #fff
        font-size: rem(24px)
        font-weight: 700
    h3
        margin: rem(28px) 0 rem(10px)
        color: #fff
        font-size: rem(19px)
        font-weight: 700
    p
        margin: 0 0 rem(16px)
        color: rgba(233, 237, 247, 0.85)
        font-size: rem(16px)
        line-height: 1.75
    ul
        margin: 0 0 rem(18px)
        padding: 0
        list-style: none
        li
            position: relative
            margin: 0 0 rem(10px)
            padding-left: rem(24px)
            color: rgba(233, 237, 247, 0.85)
            font-size: rem(16px)
            line-height: 1.65
            &::before
                position: absolute
                left: 0
                color: #8ea9ff
                content: '\2013'
    strong
        color: #fff
    a
        color: #bcd0ff

.case-meta
    display: grid
    grid-template-columns: 1fr
    gap: rem(16px)
    margin: 0 0 rem(36px)
    padding: rem(24px)
    background: rgba(255, 255, 255, 0.045)
    border: 1px solid rgba(255, 255, 255, 0.1)
    border-radius: rem(14px)
    +min(1)
        grid-template-columns: repeat(2, 1fr)
    +min(2)
        grid-template-columns: repeat(4, 1fr)
    dt
        margin: 0 0 rem(4px)
        color: #8ea9ff
        font-size: rem(12px)
        font-weight: 700
        letter-spacing: 1.5px
        text-transform: uppercase
    dd
        margin: 0
        color: #fff
        font-size: rem(15px)
        line-height: 1.5

.case-figure
    width: 100%
    margin: 0 0 rem(32px)
    overflow: hidden
    border-radius: rem(16px)
    img
        display: block
        width: 100%
        height: auto

// contact ───────────────────────────────────────────────────────────

.contact-grid
    display: grid
    grid-template-columns: 1fr
    gap: rem(36px)
    +min(2)
        grid-template-columns: 3fr 2fr

.contact-aside
    p
        margin: 0 0 rem(14px)
        color: rgba(233, 237, 247, 0.85)
        font-size: rem(15px)
        line-height: 1.7
    a
        color: #bcd0ff

.contact-links
    margin: rem(20px) 0 0
    padding: 0
    list-style: none
    li
        margin: 0 0 rem(10px)

.contact-form
    padding: rem(28px)
    background: rgba(255, 255, 255, 0.045)
    border: 1px solid rgba(255, 255, 255, 0.1)
    border-radius: rem(16px)

.field
    margin: 0 0 rem(18px)
    label
        display: block
        margin: 0 0 rem(8px)
        color: #fff
        font-size: rem(14px)
        font-weight: 600
    input, select, textarea
        width: 100%
        padding: rem(12px) rem(14px)
        color: #fff
        background: rgba(8, 12, 28, 0.6)
        border: 1px solid rgba(255, 255, 255, 0.18)
        border-radius: rem(8px)
        font-family: inherit
        font-size: rem(15px)
        &::placeholder
            color: rgba(233, 237, 247, 0.45)
        &:focus
            outline: 2px solid #8ea9ff
            outline-offset: 1px
    select
        appearance: none
    textarea
        resize: vertical

.field-row
    display: grid
    grid-template-columns: 1fr
    gap: rem(18px)
    +min(1)
        grid-template-columns: repeat(2, 1fr)

.field-consent
    display: flex
    align-items: flex-start
    gap: rem(10px)
    input
        width: auto
        margin-top: rem(4px)
    label
        margin: 0
        color: rgba(233, 237, 247, 0.85)
        font-size: rem(14px)
        font-weight: 400
        line-height: 1.6
    a
        color: #bcd0ff

.form-note
    margin: rem(16px) 0 0
    color: rgba(233, 237, 247, 0.6)
    font-size: rem(13px)
    line-height: 1.6

.hp
    position: absolute
    width: 1px
    height: 1px
    overflow: hidden
    clip: rect(0 0 0 0)
    white-space: nowrap

// success panel ─────────────────────────────────────────────────────

.success-panel
    max-width: 640px
    margin: 0 auto
    padding: rem(40px) rem(32px)
    text-align: center
    background: rgba(255, 255, 255, 0.05)
    border: 1px solid rgba(255, 255, 255, 0.12)
    border-radius: rem(18px)
    h1
        margin: 0 0 rem(14px)
        font-size: rem(30px)
    p
        margin: 0 0 rem(22px)
        color: rgba(233, 237, 247, 0.85)
        font-size: rem(16px)
        line-height: 1.7