head

    meta(charset="utf-8")

    - let _description = (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : "Senior/Lead Unity development, architecture, multiplayer optimization and project support by Marko Alerić. Remote B2B collaboration from Croatia, EU."
    - let _canonical = (typeof pageCanonical !== 'undefined' && pageCanonical) ? pageCanonical : "https://interactivesolutions.hr/"
    - let _title = (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : "Senior Unity Developer & B2B Unity Engineering | Interactive Solutions"

    meta(name="description" content= _description)

    meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=2, minimum-scale=0.5")
    meta(name="generator" content="Platframe")

    link(rel="canonical" href= _canonical)

    meta(property="og:type" content="website")
    meta(property="og:site_name" content="Interactive Solutions")
    meta(property="og:url" content= _canonical)
    meta(property="og:title" content= _title)
    meta(property="og:description" content= _description)
    meta(property="og:image" content="https://interactivesolutions.hr/assets/images/global/_linked/og-cover.jpg")
    meta(property="og:image:width" content="1200")
    meta(property="og:image:height" content="630")
    meta(property="og:image:alt" content="Interactive Solutions — Senior Unity engineering by Marko Alerić")
    meta(name="twitter:card" content="summary_large_image")
    meta(name="twitter:title" content= _title)
    meta(name="twitter:description" content= _description)
    meta(name="twitter:image" content="https://interactivesolutions.hr/assets/images/global/_linked/og-cover.jpg")

    -
        const _linkedin = "https://www.linkedin.com/in/markoaleric"
        const _github = "https://github.com/maleric2"
        const _assetstore = "https://assetstore.unity.com/publishers/40273"
        // Pages may define `pageSchema` in their context block for page-appropriate
        // structured data (Sol review); otherwise the ProfessionalService identity applies.
        const _structured = (typeof pageSchema !== 'undefined' && pageSchema) ? pageSchema : {
            "@context": "https://schema.org",
            "@type": "ProfessionalService",
            "name": "Interactive Solutions",
            "description": "Founder-led Unity and interactive-development studio led by Senior/Lead Unity Developer Marko Alerić.",
            "url": "https://interactivesolutions.hr/",
            "email": "marko@interactivesolutions.hr",
            "image": "https://interactivesolutions.hr/assets/images/global/_linked/og-cover.jpg",
            "areaServed": "Europe",
            "founder": {
                "@type": "Person",
                "name": "Marko Alerić",
                "jobTitle": "Senior / Lead Unity Developer",
                "url": "https://interactivesolutions.hr/about/",
                "sameAs": [_linkedin, _github, _assetstore]
            },
            "sameAs": [_linkedin, _github, _assetstore]
        }

    script(type="application/ld+json")!= JSON.stringify(_structured)

    title= _title

    block links
        - if (ENV === 'production')
            link(rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:400,400i,600,700&display=swap")
        link(rel="stylesheet" href=`/assets/styles/root.css?v=${ TIME }`)
        link(rel="icon" href="/favicon.ico" sizes="any")
        link(rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png")
        link(rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png")
        link(rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png")
        link(rel="manifest" href="/site.webmanifest")
        meta(name="theme-color" content="#0f1530")

    block scripts
        script(defer src=`/assets/logic/root.js?v=${ TIME }`)