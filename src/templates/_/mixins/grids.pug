//- shared content grids; single source of truth for services and featured work

mixin services-grid()
    -
        const serviceItems = [
            {
                title: 'Unity Development & Feature Delivery',
                text: 'Production-ready gameplay, UI and tooling delivered inside an existing codebase or as part of a new project.',
                examples: [
                    'Gameplay systems',
                    'UI and player-facing features',
                    'Editor and content tools',
                    'Platform integration',
                    'Addressables content delivery',
                ],
                proof: '10+ years shipping Unity features',
            },
            {
                title: 'Architecture, Performance & Project Rescue',
                text: 'Reviews and hands-on remediation for Unity projects that have become difficult to extend, debug or ship.',
                examples: [
                    'Architecture review',
                    'Refactoring strategy',
                    'Profiling and optimization',
                    'Legacy project stabilization',
                    'Build and release pipeline',
                ],
                proof: 'Production rescues and refactors',
            },
            {
                title: 'Multiplayer, Backend & Live Systems',
                text: 'Multiplayer gameplay and backend-driven features for live products, using PlayFab and production APIs.',
                examples: [
                    'Multiplayer gameplay modes',
                    'PlayFab integration',
                    'Backend-driven features',
                    'Live content and remote configuration',
                    'Progression and monetization',
                ],
                proof: 'PlayFab-backed live systems',
            },
            {
                title: 'Technical Leadership & Scoping',
                text: 'Senior technical direction and planning for teams that need it without hiring a full-time lead.',
                examples: [
                    'Technical direction',
                    'Scoping and estimates',
                    'Mentoring and code review',
                    'Hiring support',
                    'Roadmaps and task planning',
                ],
                proof: 'Lead roles on 3–20 person teams',
            },
        ]
    div(class="card-grid")
        each item in serviceItems
            +service-card(item)

mixin work-grid(limit)
    -
        const workItems = [
            {
                slug: 'light-film',
                featured: true,
                kicker: 'Light Film / Blue Raven',
                title: 'Jurassic World Rebirth: A New Era — official browser game',
                text: 'Built the official Jurassic World Rebirth: A New Era browser game from scratch in JavaScript using Phaser as part of the Light Film team. Alongside it, senior Unity development on multiplayer TV-show games and a unified platform delivered within 10–20 person teams.',
                proof: ['Phaser', 'Full-cycle implementation', 'Unity platform', 'PlayFab'],
                image: '/assets/images/work/light-film/_linked/jurassic-cover.jpg',
                srcset: '/assets/images/work/light-film/_linked/jurassic-cover-800.jpg 800w, /assets/images/work/light-film/_linked/jurassic-cover.jpg 1600w',
                sizes: '(min-width: 1024px) 640px, 92vw',
                width: 1600,
                height: 1000,
                alt: 'Gameplay from Jurassic World Rebirth: A New Era, the browser game built in Phaser',
                link: '/work/light-film-blue-raven/',
                linkText: 'Read the case study →',
            },
            {
                slug: 'hooked-on-math',
                kicker: 'Dubit Limited',
                title: 'Hooked on Math — lead Unity developer',
                text: 'Led a cross-functional team of about ten people from early planning through launch and post-release, owning estimates, feature breakdown, Unity tooling and an Addressables-based content workflow.',
                proof: ['Team leadership', 'Addressables', 'Multi-store delivery'],
                image: '/assets/images/work/hooked-on-math/_linked/cover.jpg',
                srcset: '/assets/images/work/hooked-on-math/_linked/cover-400.jpg 400w, /assets/images/work/hooked-on-math/_linked/cover-800.jpg 800w, /assets/images/work/hooked-on-math/_linked/cover.jpg 1365w',
                sizes: '(min-width: 1024px) 520px, 92vw',
                width: 1365,
                height: 768,
                alt: 'Hooked on Math cover art showing a boat and tablets running the game',
                link: '/work/hooked-on-math/',
                linkText: 'Read the case study →',
            },
            {
                slug: 'my-dubrovnik',
                kicker: 'My Dubrovnik',
                title: 'My Dubrovnik — 3D mobile city-management game',
                text: 'Worked with the Async Labs team to lead a 3D mobile city-management game from concept to its first release, building the MVP in about ten months and owning core gameplay systems and optimization.',
                proof: ['End-to-end delivery', 'Mobile optimization', '3D city simulation'],
                image: '/assets/images/work/my-dubrovnik/_linked/cover.jpg',
                srcset: '/assets/images/work/my-dubrovnik/_linked/cover-400.jpg 400w, /assets/images/work/my-dubrovnik/_linked/cover-600.jpg 600w, /assets/images/work/my-dubrovnik/_linked/cover.jpg 875w',
                sizes: '(min-width: 1024px) 520px, 92vw',
                width: 875,
                height: 500,
                alt: 'My Dubrovnik cover art showing characters in front of a 3D map of Dubrovnik',
                link: '/work/mydubrovnik/',
                linkText: 'Read the case study →',
            },
        ]
    div(class="work-grid")
        each item in workItems
            +work-card(item)
