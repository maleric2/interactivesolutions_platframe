mixin tools-grid()
    div(class="tools-grid")

        article(class="tool-card tool-card--featured")

            div(class="tool-media")
                img(
                    src="/assets/images/tools/mesh-merge/_linked/inspector.jpg"
                    srcset="/assets/images/tools/mesh-merge/_linked/inspector-800.jpg 800w, /assets/images/tools/mesh-merge/_linked/inspector.jpg 1368w"
                    sizes="(min-width: 1024px) 640px, 92vw"
                    width="1368"
                    height="766"
                    alt="MeshMerge Mesh Combiner component in the Unity inspector, showing Merge Now, Bake to Texture Array and Bake to Atlas, and Draw Calls going from 9 to 1"
                    loading="lazy")

            div(class="tool-body")

                span(class="tool-badge") Available on the Unity Asset Store
                h3(class="card-title") MeshMerge — Mesh Combiner &amp; Texture Array Baker
                p(class="card-text").
                    Merge static meshes and bake their materials into one Texture Array or Atlas
                    material. Works on Unity 2022.3, 6.3 and 6.6, URP and Built-in.
                +tag-list(['Mesh Combining', 'Texture Arrays', 'Draw Call Reduction', 'Editor Tools'])
                div(class="tool-actions")
                    a(class="btn btn-primary" href="https://assetstore.unity.com/packages/tools/utilities/meshmerge-mesh-combiner-texture-array-baker-392726?utm_source=portfolio&utm_medium=website" target="_blank" rel="noopener" data-analytics="meshmerge_store") View on the Asset Store
                    a(class="btn btn-ghost" href="/tools/mesh-merge/") Learn more →

                div(class="tool-stats")
                    p(class="tool-stat")
                        span(class="tool-stat-value") 139 → 13
                        span(class="tool-stat-label") draw calls in the showcase scene
                    p(class="tool-stat")
                        span(class="tool-stat-value") 139 → 5
                        span(class="tool-stat-label") SetPass calls, same scene
                p(class="tool-stats-note") Measured in Unity 2022.3 after a Texture Array bake. Results vary by scene and material setup.

        article(class="tool-card")

            div(class="tool-media")
                img(
                    src="/assets/images/tools/easy-house/_linked/full-street-day.jpg"
                    srcset="/assets/images/tools/easy-house/_linked/full-street-day-800.jpg 800w, /assets/images/tools/easy-house/_linked/full-street-day.jpg 1600w"
                    sizes="(min-width: 1024px) 420px, 92vw"
                    width="1600"
                    height="1067"
                    alt="A street of houses built with Easy House"
                    loading="lazy")

            div(class="tool-body")

                span(class="tool-badge tool-badge-soon") Coming soon · free Lite edition first
                h3(class="card-title") Easy House — procedural houses for Unity
                p(class="card-text").
                    Draw a footprint, get a finished house: roofs on any outline, real openings,
                    13 house types, LODs and full C# source. A free Lite edition comes first.
                +tag-list(['Procedural Generation', 'Level Design', 'House Editor'])
                div(class="tool-actions")
                    a(class="btn btn-ghost" href="/tools/easy-house/") See Easy House →
