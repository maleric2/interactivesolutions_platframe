mixin tool-card(t)
    article(class="tool-card tool-card--featured")

        a(class="tool-media" href=t.href tabindex="-1" aria-hidden="true")
            img(
                src=t.img.src
                srcset=t.img.srcset
                sizes="(min-width: 1024px) 540px, 92vw"
                width=t.img.w
                height=t.img.h
                alt=t.img.alt
                loading="lazy")

        div(class="tool-body")

            span(class=t.soon ? 'tool-badge tool-badge-soon' : 'tool-badge')= t.badge
            h3(class="card-title")
                a(href=t.href)!= t.title
            p(class="card-text")= t.text
            +tag-list(t.tags)

            div(class="tool-stats")
                each st in t.stats
                    p(class="tool-stat")
                        span(class="tool-stat-value")= st[0]
                        span(class="tool-stat-label")= st[1]
            p(class="tool-stats-note")= t.note

            div(class="tool-actions")
                each b in t.actions
                    if b.ext
                        a(class='btn ' + b.cls href=b.href target="_blank" rel="noopener" data-analytics=b.an)= b.label
                    else
                        a(class='btn ' + b.cls href=b.href data-analytics=b.an)= b.label

mixin tools-grid()
