//- site-wide building blocks shared by every page

mixin site-header({ home })
    header(class="site-header" id="site-header")
        div(class="site-header-inner")

            a(class="site-brand" href=(home ? "#front" : "/") aria-label="Interactive Solutions — home")
                svg(class="site-brand-logo" aria-hidden="true" focusable="false"): use(xlink:href="/assets/images/_sprites/symbols.svg#brand-mark-white")
                span(class="site-brand-text") Interactive Solutions

            input(class="nav-toggle" type="checkbox" id="nav-toggle")
            label(class="nav-toggle-label" for="nav-toggle" tabindex="-1")
                span(class="nav-toggle-bars" aria-hidden="true")
                span(class="visually-hidden") Toggle navigation

            nav(class="site-nav" aria-label="Primary")
                ul
                    li: a(href=(home ? "#services" : "/services/")) Services
                    li: a(href=(home ? "#work" : "/work/")) Work
                    li: a(href=(home ? "#tools" : "/tools/")) Unity Tools
                    li: a(href=(home ? "#about" : "/about/")) About
                    li: a(href=(home ? "#contact" : "/contact/")) Contact

            a(class="site-header-cta" href=(home ? "#contact" : "/contact/") data-analytics="header_cta") Discuss a Project

mixin tag-list(tags)
    ul(class="tag-list")
        each tag in tags
            li(class="tag")= tag

mixin service-card(item, compact)
    article(class="service-card")
        h3(class="card-title")= item.title
        p(class="card-text")= item.text
        if !compact
            ul(class="example-list")
                each example in item.examples
                    li(class="example-item")= example
        p(class="card-proof")= item.proof

mixin work-card(item)
    article(class="project-card" + (item.featured ? " project-card--featured" : ""))
        div(class="project-media")
            img(
                src=item.image
                srcset=item.srcset
                sizes=item.sizes
                width=item.width
                height=item.height
                alt=item.alt
                loading="lazy")
        div(class="card-body")
            p(class="card-kicker")= item.kicker
            h3(class="card-title")= item.title
            p(class="card-text")= item.text
            +tag-list(item.proof)
            if item.link
                a(class="card-link" href=item.link data-analytics=`work_${ item.slug }`)= item.linkText

mixin project-row(item)
    li(class="project-row")
        if item.image
            figure(class="project-row-thumb")
                img(
                    src=item.image
                    srcset=item.imageSrcset
                    sizes="140px"
                    width=item.imageWidth
                    height=item.imageHeight
                    alt=item.imageAlt
                    loading="lazy")
        div(class="project-row-main")
            h3(class="project-row-title")
                if item.link
                    a(href=item.link target=item.external ? "_blank" : false rel=item.external ? "noopener" : false)= item.name
                else
                    = item.name
            p(class="project-row-meta")= item.studio
        p(class="project-row-role")= item.role

mixin logo-chip(src, alt, width, height)
    figure(class="logo-chip")
        img(src=src alt=alt width=width height=height loading="lazy")

mixin callout(title, text)
    aside(class="callout")
        h3(class="callout-title")= title
        p(class="callout-text")= text

mixin cta-band(lead, href, label)
    div(class="cta-band")
        p(class="cta-band-lead")= lead
        a(class="btn btn-primary" href=href data-analytics="cta_band")= label

mixin contact-form()
    form(
        class="contact-form"
        name="project-inquiry"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/contact/success/")

        input(type="hidden" name="form-name" value="project-inquiry")

        p(class="hp")
            label Do not fill this out if you are human:
                input(name="bot-field")

        div(class="field")
            label(for="cf-situation") What best describes your situation?
            select(id="cf-situation" name="situation" required)
                option(value="" selected disabled) Please choose…
                option I need an experienced Unity developer
                option I have an existing Unity project with problems
                option I want to validate an idea with a prototype
                option I need a complete game or interactive application
                option I need help with a Unity tool or plugin
                option I am not sure yet

        div(class="field-row")
            div(class="field")
                label(for="cf-name") Name
                input(id="cf-name" type="text" name="name" required autocomplete="name")
            div(class="field")
                label(for="cf-email") Work email
                input(id="cf-email" type="email" name="email" required autocomplete="email")

        div(class="field")
            label(for="cf-company") Company / organisation
            input(id="cf-company" type="text" name="company" autocomplete="organization")

        div(class="field")
            label(for="cf-message") What do you need help with?
            textarea(id="cf-message" name="message" rows="5" required)

        div(class="field")
            label(for="cf-budget") Budget comfort range
            select(id="cf-budget" name="budget")
                option(value="" selected) Not sure yet
                option Under €3,000
                option €3,000–10,000
                option €10,000–30,000
                option €30,000–60,000
                option €60,000+
                option Not applicable

        div(class="field field-consent")
            input(id="cf-consent" type="checkbox" name="consent" required)
            label(for="cf-consent")
                | I agree to my details being used to respond to this inquiry.
                |  See the #[a(href="/privacy/") privacy policy].

        button(type="submit" class="btn btn-primary" data-analytics="contact_submit") Send inquiry

mixin contact-expectations()
    ul(class="contact-expectations")
        li Marko personally reviews every inquiry — no sales team in between.
        li The first reply focuses on the most useful next step.
        li An NDA can be discussed before you share sensitive details.
        li If the scope needs more disciplines, the proposed team and responsibilities are made explicit.

mixin pricing-section()
    -
        const engagementPaths = [
            {
                title: 'Start small',
                lead: 'For clients who need clarity before development begins.',
                items: [
                    { label: 'Idea / feasibility session', value: 'from €350' },
                    { label: 'Unity technical review', value: 'from €900' },
                ],
            },
            {
                title: 'Build a focused result',
                lead: 'For a defined feature, prototype or technical problem.',
                items: [
                    { label: 'Focused Unity development', value: 'from €1,200' },
                    { label: 'Solo prototype / vertical slice', value: 'typically €3,500–€8,000' },
                ],
            },
            {
                title: 'Scale delivery',
                lead: 'For broader scopes that need several disciplines or longer ownership.',
                items: [
                    { label: 'Team prototype / broader production phase', value: 'typically €10,000–€30,000+' },
                    { label: 'Complete project', value: 'custom scope' },
                ],
            },
        ]
    section(class="page-section page-section--showcase has-glow" id="pricing")
        div(class="section-inner")
            div(class="section-heading")
                p(class="section-eyebrow") Engagement &amp; Pricing
                h2(class="section-title") Three ways to start
                p(class="section-lead").
                    You do not need to know the right technology or team before contacting me.
                    Pick the path that matches where you are now; a short conversation confirms the rest.
            div(class="pricing-grid")
                each path in engagementPaths
                    div(class="price-path")
                        h3(class="price-path-title")= path.title
                        p(class="price-path-lead")= path.lead
                        ul(class="price-path-items")
                            each item in path.items
                                li(class="price-path-item")
                                    span(class="price-path-label")= item.label
                                    span(class="price-path-value")= item.value
            p(class="pricing-note").
                These ranges are directional. Final estimates depend on scope, technical risk, content
                requirements, integrations and team composition.
            div(class="section-actions")
                a(class="btn btn-ghost" href="/contact/" data-analytics="pricing_cta") Discuss your project →