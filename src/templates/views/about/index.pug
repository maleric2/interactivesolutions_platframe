extends ../../_/body

block context
    - bodyId = 'about';
    - bodyClass = 'page';
    - isHome = false;
    - pageTitle = 'Marko Alerić — Senior / Lead Unity Developer | Interactive Solutions';
    - pageDescription = 'Marko Alerić is a Senior/Lead Unity Developer with 10+ years of Unity experience, based in Croatia and available for remote B2B engagements.';
    - pageCanonical = 'https://interactivesolutions.hr/about/';
    - pageSchema = {"@context": "https://schema.org", "@type": "Person", "name": "Marko Alerić", "jobTitle": "Senior / Lead Unity Developer", "url": pageCanonical, "sameAs": ["https://www.linkedin.com/in/markoaleric", "https://github.com/maleric2", "https://assetstore.unity.com/publishers/40273"]};

block main

    main(role="main" id="main")

        section(class="page-hero")
            div(class="page-hero-inner")
                ul(class="breadcrumbs")
                    li: a(href="/") Home
                    li About
                h1 Senior Unity expertise, without enterprise overhead
                p Work directly with the person responsible for technical decisions and delivery.

        section(class="page-section")
            div(class="section-inner")
                div(class="section-heading")
                    h2(class="section-subtitle") Who you work with
                div(class="about-grid")
                    div
                        figure(class="about-photo")
                            img(
                                src="/assets/images/global/_linked/marko-about.jpg"
                                srcset="/assets/images/global/_linked/marko-about-480.jpg 480w, /assets/images/global/_linked/marko-about.jpg 900w"
                                sizes="(min-width: 1024px) 340px, 90vw"
                                width="900"
                                height="900"
                                alt="Marko Alerić, Senior and Lead Unity Developer"
                                loading="lazy")
                        div(class="availability")
                            h3 Available for Senior/Lead Unity roles and B2B engagements
                            ul
                                li Remote from Croatia / EU time zones
                                li Full-time, part-time or clearly scoped project work
                                li Short-term project rescue and overflow support
                                li Direct collaboration with founders, producers and engineering teams
                    div(class="about-body")
                        p.
                            I'm Marko Alerić, a Senior/Lead Unity Developer based in Croatia. I have
                            10+ years of hands-on Unity experience and have worked in game development
                            since 2014, across mobile, PC, console, multiplayer and live-game projects.
                        p.
                            I combine hands-on engineering with technical leadership, project scoping and
                            mentoring, and I teach Unity and game programming at Algebra Bernays University.
                        p.
                            Through Interactive Solutions, I work with studios that need senior ownership,
                            practical problem-solving and reliable delivery — whether that means joining an
                            existing team, stabilizing a difficult codebase or shipping a clearly scoped feature.
                        p.
                            Focused work is handled directly by me. When a larger scope needs additional
                            disciplines or capacity, Interactive Solutions can assemble and lead a trusted
                            team around the project — with me remaining the senior technical and
                            client-facing lead.
                        ul(class="proof-list")
                            li(class="proof-item") 10+ years of hands-on Unity experience
                            li(class="proof-item") Mobile, PC and console delivery
                            li(class="proof-item") Multiplayer, PlayFab and live systems
                            li(class="proof-item") Architecture, refactoring and performance work
                            li(class="proof-item") Team leadership and technical mentoring
                            li(class="proof-item") Unity Asset Store publisher
                        div(class="section-actions")
                            a(class="btn btn-secondary" href="/assets/images/global/_linked/_verbatim/CV_Marko_Aleric_EN.pdf" data-analytics="about_page_cv") Download CV
                            a(class="btn btn-ghost" href="https://www.linkedin.com/in/markoaleric" target="_blank" rel="noopener" data-analytics="about_page_linkedin") LinkedIn
                            a(class="btn btn-ghost" href="https://github.com/maleric2" target="_blank" rel="noopener" data-analytics="about_page_github") GitHub

        include ../_/recommendations

        section(class="page-section")
            div(class="section-inner")
                p(class="section-eyebrow") Career
                h2(class="section-title") Timeline
                div(class="career-timeline prose")
                    article(class="career-timeline-item")
                        p(class="career-timeline-period") 02/2016 – 03/2016
                        h3(class="career-timeline-role") Nanobit — Game Developer Intern
                        p Learning the craft inside an established studio: Cocos2d-x development with mentoring in programming best practices.
                    article(class="career-timeline-item")
                        p(class="career-timeline-period") 06/2016 – 02/2020
                        h3(class="career-timeline-role") Exordium Games — Game Developer
                        p.
                            Nearly four years across studio titles — Zero Reflex, Agenda, Last Encounter
                            and Bear With Me — covering QA, features, console ports, platform releases,
                            LiveOps and mentoring, plus client work including 20+ published Legends of
                            Learning educational games, CARNET e-Schools content, Voodoo hypercasual
                            titles and SelfDevices apps.
                    article(class="career-timeline-item")
                        p(class="career-timeline-period") 05/2019 – 07/2019
                        h3(class="career-timeline-role") Geo Log j.d.o.o. — Programmer
                        p.
                            Short programming engagement: mockups, design and leading development of
                            GRIP, a mountain-route app for Anića Kuk.
                    article(class="career-timeline-item")
                        p(class="career-timeline-period") 02/2020 – 04/2021
                        h3(class="career-timeline-role") Async Labs — Lead Unity Developer
                        p.
                            Led and developed the 3D mobile city-management game My Dubrovnik from
                            concept to its first release: full specification work, economy and
                            monetization systems, crowd, camera, save and localization systems.
                            #[a(href="/work/my-dubrovnik/") Read the My Dubrovnik case study →]
                    article(class="career-timeline-item")
                        p(class="career-timeline-period") 02/2016 – 06/2022 · in parallel
                        h3(class="career-timeline-role") Cybertale Studio — Developer, Project Manager, Designer
                        p.
                            Independent work alongside full-time roles, starting as Triple Head Games:
                            Hack Fu (2D hack &amp; slash with procedural room generation), Snitcher's
                            Glove and the online multiplayer beat 'em up Splash Kings.
                    article(class="career-timeline-item")
                        p(class="career-timeline-period") Since 06/2021
                        h3(class="career-timeline-role") Interactive Solutions, obrt — Founder
                        p.
                            Founded Interactive Solutions as an independent Unity engineering and product
                            studio for international B2B work — the structure behind all client
                            engagements since, plus the MeshMerge Asset Store product.
                    article(class="career-timeline-item")
                        p(class="career-timeline-period") 05/2021 – 01/2023
                        h3(class="career-timeline-role") Dubit Limited — Senior, then Lead Unity Developer
                        p.
                            Joined through the obrt as a senior on Hooked on Phonics and Hooked on
                            Spelling, promoted to lead after half a year. Led a cross-functional team of
                            about ten people on Hooked on Math from planning through launch and
                            post-release across Google, Apple, Amazon and Windows stores via cloud builds
                            and Addressables, then led BestLife from its beginning through its first
                            released version. Also completed one Cybertale Studio gig through the obrt.
                            #[a(href="/work/hooked-on-math/") Read the Hooked on Math case study →]
                    article(class="career-timeline-item")
                        p(class="career-timeline-period") 02/2023 – 09/2023
                        h3(class="career-timeline-role") Room 8 Studio, Solid Bash department — Lead Unity Developer
                        p.
                            Moved directly from Dubit to Room 8 Studio: lead developer on a Runner and a
                            City Builder for Amazon and Apple — pre-production analysis, architecture,
                            Addressables, controllers, UI, world-grid systems and effects in teams of
                            roughly 10–20.
                    article(class="career-timeline-item")
                        p(class="career-timeline-period") Since 11/2023
                        h3(class="career-timeline-role") Algebra Bernays University — External Lecturer
                        p.
                            Transitioned to lecturing alongside independent client work: C++, 2D and 3D
                            game development, web technologies, advanced development and VFX.
                    article(class="career-timeline-item")
                        p(class="career-timeline-period") Since 12/2023
                        h3(class="career-timeline-role") Light Film / Blue Raven — Senior Unity Developer
                        p.
                            New client alongside lecturing: multiplayer TV-show games and a unified game
                            platform (PlayFab backend, Firebase analytics, Amazon and Apple platforms),
                            plus the official Jurassic World Rebirth browser game built from scratch in
                            Phaser. #[a(href="/work/light-film-blue-raven/") Read the Light Film case study →]
                    p(class="career-timeline-note").
                        Employment, parallel independent work and client engagements are shown as held:
                        studio roles where employed, client work where contracted through the obrt. The
                        Work page names the studio and role behind each project.

        section(class="page-section page-section--showcase")
            div(class="section-inner")
                p(class="section-eyebrow") Working model
                h2(class="section-title") Direct, with a team when the scope needs one
                div(class="prose")
                    p.
                        Focused work is handled directly by me. When a larger scope needs additional
                        disciplines or capacity, Interactive Solutions can assemble and lead a trusted
                        team around the project — with me remaining the senior technical and
                        client-facing lead.
                div(class="section-actions")
                    a(class="btn btn-secondary" href="/assets/images/global/_linked/_verbatim/CV_Marko_Aleric_EN.pdf" data-analytics="about_page_cv") Download CV
                    a(class="btn btn-ghost" href="https://www.linkedin.com/in/markoaleric" target="_blank" rel="noopener" data-analytics="about_page_linkedin") LinkedIn
                    a(class="btn btn-ghost" href="https://github.com/maleric2" target="_blank" rel="noopener" data-analytics="about_page_github") GitHub
                    a(class="btn btn-ghost" href="https://assetstore.unity.com/publishers/40273?utm_source=portfolio&utm_medium=website" target="_blank" rel="noopener" data-analytics="about_page_publisher") Asset Store

        section(class="page-section page-section--editorial")
            div(class="section-inner")
                p(class="section-eyebrow") Background
                h2(class="section-title") Education &amp; recognition
                div(class="prose")
                    p.
                        Magistar informatike from the Faculty of Organization and Informatics
                        (University of Zagreb), with both theses in game development: a Unity mobile
                        game for the bachelor's thesis, graded highest, and agent-based game AI —
                        behaviour trees, steering behaviours and formations — for the master's.
                    p.
                        Competitive record includes 1st place at the Infinum hackathon (2014) and 3rd
                        at Nordeus (2016), plus Global Game Jam entries; as a student I also ran Unity
                        workshops for fellow students. Full credentials, courses and certificates are
                        in the downloadable CV.

        section(class="page-section")
            div(class="section-inner")
                +cta-band('Want to talk about a role or an engagement?', '/contact/', 'Get in Touch')
