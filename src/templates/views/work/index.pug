extends ../../_/body

block context
    - bodyId = 'work';
    - bodyClass = 'page';
    - isHome = false;
    - pageTitle = 'Selected Unity Work & Case Studies | Interactive Solutions';
    - pageDescription = 'Selected Unity projects and case studies: multiplayer TV-show games, Amazon- and Apple-related work, and a shipped 3D mobile city-management game.';
    - pageCanonical = 'https://interactivesolutions.hr/work/';

block main

    main(role="main" id="main")

        section(class="page-hero")
            div(class="page-hero-inner")
                ul(class="breadcrumbs")
                    li: a(href="/") Home
                    li Work
                h1 Selected work
                p.
                    Real projects, responsibilities and technical decisions — not a generic capability list.

        section(class="page-section")
            div(class="section-inner")
                div(class="work-grid")
                    +work-card({
                        slug: 'light-film',
                        kicker: 'Light Film / Blue Raven',
                        title: 'Multiplayer TV-show games and a unified Unity platform',
                        text: 'Senior Unity development across a 10–20 person team, contributing to multiplayer gameplay and shared platform systems with PlayFab-backed functionality, including work related to Jurassic World.',
                        tags: ['Multiplayer', 'PlayFab', 'Live Systems', 'Platform'],
                        image: '/assets/images/global/_linked/work-light-film.jpg',
                        alt: 'Abstract low-poly artwork used as a placeholder for the Light Film / Blue Raven case study',
                        link: '/work/light-film-blue-raven/',
                    })
                    +work-card({
                        slug: 'room-8',
                        kicker: 'Room 8 Studio',
                        title: 'Lead Unity work on Amazon- and Apple-related projects',
                        text: 'Senior and lead Unity development on Amazon- and Apple-related initiatives delivered through Room 8 Studio. Details remain confidential; the scope covered systems, platforms and technical ownership.',
                        tags: ['Amazon-related', 'Apple-related', 'Lead', 'Systems'],
                        image: '/assets/images/global/_linked/work-room8.jpg',
                        alt: 'Abstract low-poly artwork used as a placeholder for confidential Room 8 Studio work',
                    })
                    +work-card({
                        slug: 'mydubrovnik',
                        kicker: 'MyDubrovnik',
                        title: 'Lead development of a shipped 3D mobile city-management game',
                        text: 'Led a five-person team from technical planning through delivery, designed core systems and optimized the game for lower-end mobile devices.',
                        tags: ['Lead', 'Mobile', '3D', 'Optimization'],
                        image: '/assets/images/global/_linked/work-mydubrovnik.jpg',
                        alt: 'Abstract low-poly artwork used as a placeholder for the MyDubrovnik case study',
                        link: '/work/mydubrovnik/',
                    })

        section(class="page-section")
            div(class="section-inner")
                p(class="section-eyebrow") Shipped titles
                h2(class="section-title") Selected shipped titles
                p(class="section-lead").
                    Experience includes work on commercial titles across mobile, PC and console.
                    Roles and specific contributions are available on request.
                div(class="prose")
                    ul
                        li Bear With Me
                        li Last Encounter
                        li Agenda
                        li Zero Reflex
                        li Pottery
                        li Legends of Learning
                        li MyDubrovnik
                div(class="callout")
                    h4(class="callout-title") Capabilities proven by this work
                    p(class="callout-text").
                        Mobile, PC and console delivery; Addressables and remote content delivery;
                        PlayFab, multiplayer and live systems; optimization for lower-end devices;
                        architecture, editor tools and procedural content; team leadership and
                        client communication.

        section(class="page-section")
            div(class="section-inner")
                +cta-band('Need senior Unity ownership on your project?', '/contact/', 'Discuss Your Unity Project')