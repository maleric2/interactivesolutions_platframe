extends ../../../_/body

block context
    - bodyId = 'case-light-film';
    - bodyClass = 'page';
    - isHome = false;
    - pageTitle = 'Jurassic World Rebirth: A New Era — official browser game | Interactive Solutions';
    - pageDescription = 'Case study: building the official Jurassic World Rebirth: A New Era browser game from scratch in Phaser, alongside senior Unity work on multiplayer TV-show games and a unified platform.';
    - pageCanonical = 'https://interactivesolutions.hr/work/light-film-blue-raven/';

block main

    main(role="main" id="main")

        section(class="page-hero")
            div(class="page-hero-inner")
                ul(class="breadcrumbs")
                    li: a(href="/") Home
                    li: a(href="/work/") Work
                    li Light Film / Blue Raven
                h1 Jurassic World Rebirth: A New Era — official browser game
                p Built from scratch in JavaScript using Phaser as part of the Light Film team, alongside senior Unity work on multiplayer TV-show games and a shared platform.

        section(class="page-section page-section--editorial")
            div(class="section-inner")

                dl(class="case-meta")
                    div
                        dt Role
                        dd Senior developer — full game implementation
                    div
                        dt Team context
                        dd Light Film / Blue Raven
                    div
                        dt Team size
                        dd 10–20 people
                    div
                        dt Stack
                        dd JavaScript · Phaser · Unity · PlayFab

                div(class="prose")

                    h2 Context
                    p.
                        Light Film / Blue Raven produced multiplayer games tied to TV-show formats,
                        alongside a shared Unity platform that multiple titles could build on. Work in
                        this space included projects related to Jurassic World, delivered within teams
                        of roughly ten to twenty people.

                    h2 My role
                    p.
                        I built the official #[strong Jurassic World Rebirth: A New Era] browser game
                        from scratch in JavaScript using Phaser — a full, playable implementation
                        rather than a single feature inside an existing engine.

                    h2 Technical challenge
                    p.
                        A browser game tied to a global entertainment property has to load quickly,
                        play consistently across browsers and devices, and hold up as a finished
                        public experience. Building it from zero meant owning the whole
                        implementation rather than slotting into an established codebase.

                    h2 Decisions and implementation
                    ul
                        li Implemented the complete game from scratch in JavaScript with Phaser.
                        li Delivered it as a responsive browser experience.
                        li Worked within a 10–20 person team alongside the studio's other titles.

                    h2 Outcome
                    p.
                        The game shipped and is live as the official experience:
                        #[a(href="https://www.jurassicworld.com/anewera/" target="_blank" rel="noopener") jurassicworld.com/anewera].

                    h2 Broader Unity scope at Light Film
                    p.
                        Alongside the browser game, I did senior Unity development on multiplayer
                        TV-show games and a unified platform — contributing to multiplayer gameplay
                        and shared platform systems, with PlayFab-backed functionality. Firebase was
                        evaluated during development.

                    h2 Technologies
                    p JavaScript · Phaser · Unity · C# · PlayFab

                figure(class="case-figure case-figure--narrow")
                    img(
                        src="/assets/images/work/light-film/_linked/jurassic-gameplay.jpg"
                        srcset="/assets/images/work/light-film/_linked/jurassic-gameplay-400.jpg 400w, /assets/images/work/light-film/_linked/jurassic-gameplay.jpg 680w"
                        sizes="(min-width: 1024px) 440px, 92vw"
                        width="680"
                        height="1210"
                        alt="Jurassic World Rebirth: A New Era browser game in play, showing a boat and a dinosaur in the water"
                        loading="lazy")
                    figcaption Gameplay from the official browser game built in Phaser.

                div(class="callout")
                    h4(class="callout-title") A note on attribution
                    p(class="callout-text").
                        This work was completed as part of the Light Film team. It is presented to
                        describe my own contribution accurately and does not imply direct employment
                        or commissioning by the brand owners. Some project detail remains confidential.

        section(class="page-section page-section--cinematic has-glow")
            div(class="section-inner")
                +cta-band('Working on a browser or Unity project?', '/contact/', 'Discuss Your Unity Project')