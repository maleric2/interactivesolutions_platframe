extends ../../../_/body

block context
    - bodyId = 'case-mydubrovnik';
    - bodyClass = 'page';
    - isHome = false;
    - pageTitle = 'MyDubrovnik — shipped 3D mobile city-management game — Case Study | Interactive Solutions';
    - pageDescription = 'Case study: leading development of MyDubrovnik, a shipped 3D mobile city-management game, from technical planning to delivery.';
    - pageCanonical = 'https://interactivesolutions.hr/work/mydubrovnik/';

block main

    main(role="main" id="main")

        section(class="page-hero")
            div(class="page-hero-inner")
                ul(class="breadcrumbs")
                    li: a(href="/") Home
                    li: a(href="/work/") Work
                    li MyDubrovnik
                h1 MyDubrovnik — a shipped 3D mobile city-management game
                p Leading a small team from technical planning through delivery and optimization.

        section(class="page-section")
            div(class="section-inner")

                dl(class="case-meta")
                    div
                        dt Role
                        dd Lead Unity Developer
                    div
                        dt Project
                        dd MyDubrovnik
                    div
                        dt Team
                        dd 5 people
                    div
                        dt Platform
                        dd Mobile · 3D

                div(class="prose")

                    h2 Context
                    p.
                        MyDubrovnik was a 3D mobile city-management game built around a real-world
                        location. The project needed a small team to move from concept to a shipped
                        product that would run acceptably on lower-end mobile hardware.

                    h2 My role
                    p.
                        I led Unity development for a five-person team, owning technical planning,
                        core system design and the optimization work needed to reach mobile devices.

                    h2 Technical challenge
                    p.
                        A 3D city-management game on mobile has to balance visual scope against device
                        limits. Lower-end devices were the constraint that shaped architectural and
                        content decisions from early on.

                    h2 Decisions and implementation
                    ul
                        li Planned the technical approach and system structure for the team.
                        li Designed and implemented core gameplay and management systems.
                        li Drove optimization work targeting lower-end mobile devices.
                        li Coordinated delivery across the small team through to release.

                    h2 Outcome
                    p.
                        The game was completed and shipped as a 3D mobile title. Store links,
                        screenshots and public ratings can be provided on request.

                    h2 Technologies
                    p Unity · C# · Mobile optimization · 3D content pipelines

                div(class="callout")
                    h4(class="callout-title") Team delivery
                    p(class="callout-text").
                        This was a team effort. The role described here is technical leadership and
                        hands-on development within that team, not independent authorship of the title.

        section(class="page-section")
            div(class="section-inner")
                +cta-band('Need a senior lead for a small, focused team?', '/contact/', 'Discuss Your Unity Project')