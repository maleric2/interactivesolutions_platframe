extends ../_/body

//- variables
block context
    - bodyId = 'home';
    - bodyClass = 'home';
    - isHome = true;
    - pageTitle = 'Senior Unity Developer & B2B Unity Engineering | Interactive Solutions';
    - pageDescription = 'Senior/Lead Unity development, architecture, multiplayer optimization and project support by Marko Alerić. Remote B2B collaboration from Croatia, EU.';
    - pageCanonical = 'https://interactivesolutions.hr/';

//- body
block main

    main(role="main" id="main")

        include _/front

        section(class="proof-strip" aria-label="Experience highlights")
            div(class="proof-strip-inner")
                div(class="proof-stat")
                    strong(class="proof-stat-value") 10+ years
                    span(class="proof-stat-label") Hands-on Unity experience
                div(class="proof-stat")
                    strong(class="proof-stat-value") 3–20 people
                    span(class="proof-stat-label") Lead roles on delivery teams
                div(class="proof-stat")
                    strong(class="proof-stat-value") Mobile · browser · tools
                    span(class="proof-stat-label") Shipped and public work
                div(class="proof-stat")
                    strong(class="proof-stat-value") Founder-led
                    span(class="proof-stat-label") Direct senior technical ownership

        include _/work
        include _/services
        include _/tools
        include _/about
        include _/testimonial-featured
        include _/engagement-cta
        include _/contact
