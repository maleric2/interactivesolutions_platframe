extends ../../_/body

block context
    - bodyId = 'tools';
    - bodyClass = 'page';
    - isHome = false;
    - pageTitle = 'Unity Tools & Editor Plugins | Interactive Solutions';
    - pageDescription = 'Unity tools built from production problems: Mesh Merge, a mesh combiner and texture array baker, and Easy House, procedural house generation for Unity.';
    - pageCanonical = 'https://interactivesolutions.hr/tools/';

block main

    main(role="main" id="main")

        section(class="page-hero")
            div(class="page-hero-inner")
                ul(class="breadcrumbs")
                    li: a(href="/") Home
                    li Unity Tools
                h1 Unity tools built from production problems
                p Editor tools and workflows designed to remove repetitive work and improve runtime efficiency.

        section(class="page-section")
            div(class="section-inner")
                div(class="section-heading")
                    h2(class="section-subtitle") Products
                +tools-grid()

        section(class="page-section")
            div(class="section-inner")
                div(class="section-heading")
                    p(class="section-eyebrow") More from the publisher
                    h2(class="section-title") All Unity tools by Interactive Solutions
                div(class="section-actions")
                    a(class="btn btn-secondary" href="https://assetstore.unity.com/publishers/40273" target="_blank" rel="noopener" data-analytics="tools_page_publisher") View the publisher profile →
                div(class="callout")
                    h3(class="callout-title") More tools in development
                    p(class="callout-text") More Unity production tools are in development. No release dates are promised before a public demo exists.