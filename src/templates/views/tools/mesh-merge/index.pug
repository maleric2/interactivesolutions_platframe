extends ../../../_/body

block context
    - bodyId = 'mesh-merge';
    - bodyClass = 'page';
    - isHome = false;
    - pageTitle = 'MeshMerge — Mesh Combiner & Texture Array Baker for Unity | Interactive Solutions';
    - pageDescription = 'MeshMerge combines meshes and materials into an optimized Unity workflow using atlas or texture-array baking. Available on the Unity Asset Store.';
    - pageCanonical = 'https://interactivesolutions.hr/tools/mesh-merge/';

block main

    main(role="main" id="main")

        section(class="page-hero")
            div(class="page-hero-inner")
                ul(class="breadcrumbs")
                    li: a(href="/") Home
                    li: a(href="/tools/") Unity Tools
                    li MeshMerge
                h1 MeshMerge — Mesh Combiner &amp; Texture Array Baker
                p Combine meshes and materials into an optimized workflow built for real Unity projects.

        section(class="page-section")
            div(class="section-inner")

                div(class="section-actions")
                    a(class="btn btn-primary" href="https://assetstore.unity.com/packages/tools/utilities/meshmerge-mesh-combiner-texture-array-baker-392726" target="_blank" rel="noopener" data-analytics="meshmerge_page_store") View on the Unity Asset Store
                    a(class="btn btn-ghost" href="https://assetstore.unity.com/publishers/40273" target="_blank" rel="noopener" data-analytics="meshmerge_page_publisher") More tools by Interactive Solutions

                figure(class="case-figure case-figure--wide")
                    img(
                        src="/assets/images/tools/mesh-merge/_linked/inspector.jpg"
                        srcset="/assets/images/tools/mesh-merge/_linked/inspector-800.jpg 800w, /assets/images/tools/mesh-merge/_linked/inspector.jpg 1368w"
                        sizes="(min-width: 1024px) 740px, 92vw"
                        width="1368"
                        height="766"
                        alt="MeshMerge Mesh Combiner component in the Unity inspector, showing Merge Now, Bake to Texture Array and Bake to Atlas, and Draw Calls going from 9 to 1"
                        loading="lazy")
                    figcaption The Mesh Combiner component: merge, then bake to a texture array or atlas.

                figure(class="case-figure case-figure--wide")
                    img(
                        src="/assets/images/tools/mesh-merge/_linked/bake-to-atlas.gif"
                        width="1368"
                        height="764"
                        alt="Animated demonstration of baking combined meshes to a single atlas material"
                        loading="lazy")
                    figcaption Baking to a single atlas material.

                div(class="prose")
                    h2 What it does
                    p.
                        MeshMerge combines multiple meshes and materials so scenes and prefabs can be
                        rendered with fewer draw calls. It supports two baking workflows — a texture
                        atlas and a texture array — so the right approach can be chosen per material setup.
                    ul
                        li Combine meshes into a single mesh.
                        li Bake materials into a texture atlas or a texture array.
                        li Reduce material and submesh complexity in production scenes.
                        li Designed as an editor tool for real Unity projects rather than toy scenes.

                    h2 Two baking workflows
                    h3 Bake to Atlas
                    p.
                        Packs material textures into a single atlas texture, letting combined geometry
                        share one material. Best where materials share comparable texture requirements.
                    h3 Bake to Texture Array
                    p.
                        Packs textures into a texture array, keeping per-material texture detail without
                        an atlas layout. Best where atlas packing would otherwise distort or degrade results.

                    h2 Support and documentation
                    p.
                        Documentation and support are handled through the Asset Store listing and by
                        email. If you run into an issue with a specific Unity version or render pipeline,
                        include the version and a short description in your message.

                div(class="callout callout--honest")
                    h3(class="callout-title") Honest claim policy
                    p(class="callout-text").
                        Performance varies by scene, material setup and target platform. The tool reduces
                        draw calls and material complexity; it is not a universal guarantee of a specific
                        frame-rate improvement.

        section(class="page-section")
            div(class="section-inner")
                +cta-band('Questions about MeshMerge?', 'mailto:marko@interactivesolutions.hr?subject=Mesh%20Merge%20support', 'Email support')
