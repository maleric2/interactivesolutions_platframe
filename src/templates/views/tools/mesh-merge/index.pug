extends ../../../_/body

block context
    - bodyId = 'mesh-merge';
    - bodyClass = 'page';
    - isHome = false;
    - pageTitle = 'MeshMerge — Mesh Combiner & Texture Array Baker for Unity | Interactive Solutions';
    - pageDescription = 'MeshMerge is a free Unity tool that merges static meshes and bakes their materials into one Texture Array or Atlas material for fewer draw calls. Unity 2022.3, 6.3 and 6.6, URP and Built-in.';
    - pageCanonical = 'https://interactivesolutions.hr/tools/mesh-merge/';
    - mmTrailer = {src: '/media/meshmerge-1.4-trailer.mp4', poster: '/assets/images/tools/mesh-merge/_linked/trailer-poster.jpg'};
    - pageSchema = {"@context": "https://schema.org", "@type": "SoftwareApplication", "name": "MeshMerge — Mesh Combiner and Texture Array Baker", "applicationCategory": "DeveloperApplication", "operatingSystem": "Windows, macOS, Linux (Unity Editor 2022.3, 6.3, 6.6)", "description": pageDescription, "url": pageCanonical, "offers": {"@type": "Offer", "url": "https://assetstore.unity.com/packages/tools/utilities/meshmerge-mesh-combiner-texture-array-baker-392726", "availability": "https://schema.org/InStock"}};

block main

    main(role="main" id="main")

        section(class="page-hero")
            div(class="page-hero-inner")
                ul(class="breadcrumbs")
                    li: a(href="/") Home
                    li: a(href="/tools/") Unity Tools
                    li MeshMerge
                p(class="page-hero-badge") New in 1.4 · Free
                h1 MeshMerge — Mesh Combiner &amp; Texture Array Baker
                p A free Unity tool. Merge static meshes and bake their materials into one Texture Array or Atlas material, so real Unity scenes render with far fewer draw calls.

        section(class="page-section")
            div(class="section-inner")

                div(class="section-actions")
                    a(class="btn btn-primary" href="https://assetstore.unity.com/packages/tools/utilities/meshmerge-mesh-combiner-texture-array-baker-392726?utm_source=portfolio&utm_medium=website" target="_blank" rel="noopener" data-analytics="meshmerge_page_store") View on the Unity Asset Store
                    a(class="btn btn-ghost" href="#new-in-1-4") What's new in 1.4 →

                div(class="release-band" id="new-in-1-4")
                    p(class="section-eyebrow") New in 1.4
                    h2(class="release-band-title") Measured, not estimated
                    p(class="release-band-lead").
                        1.4 adds a showcase scene and a way to measure real draw calls in a player, so you can
                        check the numbers on this page against your own project.
                    if mmTrailer
                        figure(class="case-figure case-figure--wide release-band-video")
                            video(
                                class="tool-video"
                                controls
                                preload="none"
                                playsinline
                                width="1920"
                                height="1080"
                                poster=mmTrailer.poster)
                                source(src=mmTrailer.src type="video/mp4")
                            figcaption The MeshMerge 1.4 trailer.
                    ul(class="feature-grid feature-grid--three")
                        li(class="feature-card")
                            h3(class="feature-title") Showcase scene
                            p(class="feature-text") #[strong GameObject › MeshMerge › Create Showcase Scene] builds a town square of 9 buildings and 135 renderers to try the whole workflow on.
                        li(class="feature-card")
                            h3(class="feature-title") Measured draw calls
                            p(class="feature-text") The command line builds a short development player and records draw calls, SetPass calls, batches and triangles before and after a merge or bake.
                        li(class="feature-card")
                            h3(class="feature-title") Release fixes
                            p(class="feature-text") The render check no longer saves its camera colour, release players skip the merge trace log, and the User Guide's runtime example compiles.

                figure(class="case-figure case-figure--wide")
                    img(
                        src="/assets/images/tools/mesh-merge/_linked/inspector.jpg"
                        srcset="/assets/images/tools/mesh-merge/_linked/inspector-800.jpg 800w, /assets/images/tools/mesh-merge/_linked/inspector.jpg 1368w"
                        sizes="(min-width: 1024px) 740px, 92vw"
                        width="1368"
                        height="766"
                        alt="MeshMerge Mesh Combiner component in the Unity inspector, showing Merge Now, Bake to Texture Array and Bake to Atlas, and Draw Calls going from 9 to 1"
                        loading="lazy")
                    figcaption The Mesh Combiner component: merge, then bake to a texture array or atlas.

                figure(class="case-figure case-figure--wide")
                    img(
                        src="/assets/images/tools/mesh-merge/_linked/bake-to-atlas.gif"
                        width="1368"
                        height="764"
                        alt="Animated demonstration of baking combined meshes to a single atlas material"
                        loading="lazy")
                    figcaption Baking to a single atlas material.

                div(class="proof-strip-inner proof-strip-inner--flush" aria-label="MeshMerge at a glance")
                    div(class="proof-stat")
                        span(class="proof-stat-value") 139 → 13 draw calls
                        span(class="proof-stat-label") Showcase scene after a Texture Array bake
                    div(class="proof-stat")
                        span(class="proof-stat-value") 139 → 5 SetPass calls
                        span(class="proof-stat-label") Same scene, same measurement
                    div(class="proof-stat")
                        span(class="proof-stat-value") Unity 2022.3 · 6.3 · 6.6
                        span(class="proof-stat-label") URP recommended, Built-in supported
                    div(class="proof-stat")
                        span(class="proof-stat-value") Free, full source
                        span(class="proof-stat-label") MIT license, no third-party dependencies

                div(class="prose")
                    h2 What it does
                    p.
                        MeshMerge combines static meshes and materials so scenes and prefabs render with
                        fewer draw calls. Merge a hierarchy into one mesh, then bake its materials into a
                        single Texture Array or Atlas material, all from one Inspector component.

                ul(class="feature-grid")
                    li(class="feature-card")
                        h3(class="feature-title") Mesh Combiner
                        p(class="feature-text") Merge child MeshRenderers into one mesh, or split a multi-submesh mesh back into separate objects.
                    li(class="feature-card")
                        h3(class="feature-title") Texture Array bake
                        p(class="feature-text") Many tiling materials become one texture-array material. Each keeps its own slice, metallic and smoothness.
                    li(class="feature-card")
                        h3(class="feature-title") Atlas bake
                        p(class="feature-text") Non-tiling textures pack into one atlas. The bake is refused up front if UVs would break it.
                    li(class="feature-card")
                        h3(class="feature-title") LOD groups
                        p(class="feature-text") Merge per LOD level and keep the switch distances of the source LODGroups.
                    li(class="feature-card")
                        h3(class="feature-title") Optimize Scene window
                        p(class="feature-text") Find and process the combiners in a scene from one window instead of one object at a time.
                    li(class="feature-card")
                        h3(class="feature-title") Honest statistics
                        p(class="feature-text") The Inspector shows facts and estimates from the real merge plan, kept apart so nothing is overstated.
                    li(class="feature-card")
                        h3(class="feature-title") Safe to undo
                        p(class="feature-text") Merges and bakes are single Undo steps, roll back on failure, and an Edit Mode restores the source parts.
                    li(class="feature-card")
                        h3(class="feature-title") Scriptable and headless
                        p(class="feature-text") A MeshMergeApi and a batch-mode command line run merges in CI, with a JSON report and a render check.

                div(class="prose")
                    h2 Which bake to use
                    div(class="table-wrap")
                        table(class="spec-table")
                            thead
                                tr
                                    th(scope="col") Bake
                                    th(scope="col") Best for
                                    th(scope="col") Result
                            tbody
                                tr
                                    th(scope="row") Texture Array
                                    td Tiling textures: walls, roofs, floors
                                    td One texture-array material, UVs can repeat freely
                                tr
                                    th(scope="row") Atlas
                                    td Non-tiling textures with UVs inside 0–1
                                    td One atlas material

                    h2 Compatibility
                    div(class="table-wrap")
                        table(class="spec-table")
                            tbody
                                tr
                                    th(scope="row") Unity
                                    td 2022.3 LTS, 6.3 and 6.6
                                tr
                                    th(scope="row") Render pipeline
                                    td URP 14+ (recommended) or Built-in. HDRP is not supported
                                tr
                                    th(scope="row") Input
                                    td Static MeshRenderer + MeshFilter hierarchies
                                tr
                                    th(scope="row") Dependencies
                                    td None beyond Unity's own URP package
                                tr
                                    th(scope="row") Release checks
                                    td 576 automated editor tests, run on every supported Unity version

                    h2 Version history
                    div(class="table-wrap")
                        table(class="spec-table")
                            tbody
                                tr
                                    th(scope="row") 1.4
                                    td Showcase scene, measured draw calls from the command line, release fixes
                                tr
                                    th(scope="row") 1.3
                                    td Headless API and command line, Optimize Scene, LOD merging per level, per-slice metallic and smoothness
                                tr
                                    th(scope="row") 1.2
                                    td Reliable large merges with rollback, safe bakes, honest statistics, dockable window, Unity 6.3 and 6.6
                                tr
                                    th(scope="row") 1.0
                                    td First release: Mesh Combiner, Texture Array and Atlas bakers, Mesh Splitter, runtime merging
                    p.
                        Version 1.4 is on its way to the Asset Store.

                    h2 Support and documentation
                    p.
                        A full User Guide ships with the package. Support is handled through the Asset Store
                        listing and by email. If you run into an issue with a specific Unity version or render
                        pipeline, include the version and a short description in your message.

                div(class="callout callout--honest")
                    h3(class="callout-title") How the numbers were measured
                    p(class="callout-text").
                        139 → 13 draw calls and 139 → 5 SetPass calls were measured on the bundled showcase scene
                        in Unity 2022.3, Built-in pipeline, shadows off, after a Texture Array bake. Your results
                        depend on the scene, material setup and target platform. MeshMerge supports static meshes
                        only; skinned meshes are not merged.

        section(class="page-section")
            div(class="section-inner")
                +cta-band('Questions about MeshMerge?', 'mailto:marko@interactivesolutions.hr?subject=Mesh%20Merge%20support', 'Email support')
