extends ../../_/body

block context
    - bodyId = 'privacy';
    - bodyClass = 'page';
    - isHome = false;
    - pageTitle = 'Privacy Policy | Interactive Solutions';
    - pageDescription = 'How Interactive Solutions handles personal data submitted through the contact form and general site usage.';
    - pageCanonical = 'https://interactivesolutions.hr/privacy/';

block main

    main(role="main" id="main")

        section(class="page-hero")
            div(class="page-hero-inner")
                ul(class="breadcrumbs")
                    li: a(href="/") Home
                    li Privacy
                h1 Privacy policy
                p How personal data submitted through this site is handled.

        section(class="page-section")
            div(class="section-inner")
                div(class="prose")

                    h2 Who is responsible
                    p.
                        This site is operated by Interactive Solutions, obrt za programiranje,
                        vl. Marko Alerić, Runović, Croatia. For any privacy question, contact
                        #[a(href="mailto:marko@interactivesolutions.hr") marko@interactivesolutions.hr].

                    h2 What is collected
                    p.
                        If you submit the contact form, the details you enter — such as your name,
                        work email, company, project description, budget range and consent — are
                        collected so the inquiry can be answered. If you email directly, the contents
                        of your message and your email address are received.
                    p.
                        Basic, aggregated usage information may be collected to understand how the
                        site is used. No account profiling or selling of personal data takes place.
                    p.
                        The site does not currently load third-party analytics, advertising or
                        tracking scripts. If analytics are introduced in future, this policy will be
                        updated before they are enabled.

                    h2 How it is used
                    p Personal data is used only to respond to the inquiry and to manage the resulting communication. It is not sold or shared with third parties for marketing.

                    h2 Form handling
                    p.
                        Contact form submissions are processed by Netlify, the hosting provider, as a
                        form-handling service. Their privacy terms apply to that processing.

                    h2 Retention
                    p.
                        Inquiry correspondence is kept only as long as needed for the purpose above or
                        as required by law, after which it is deleted.

                    h2 Your rights
                    p.
                        You can request access to, correction of, or deletion of the personal data
                        held about you by writing to the email address above.

                    h2 Cookies
                    p.
                        This site does not set marketing or tracking cookies. The hosting provider may
                        set strictly necessary cookies to serve the site and process form submissions.