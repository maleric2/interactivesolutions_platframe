extends ../../_/body

block context
    - bodyId = 'services';
    - bodyClass = 'page';
    - isHome = false;
    - pageTitle = 'Unity Development Services | Interactive Solutions';
    - pageDescription = 'Senior Unity development, architecture and performance rescue, multiplayer and live systems, and technical leadership from Marko Alerić.';
    - pageCanonical = 'https://interactivesolutions.hr/services/';
    - pageSchema = {"@context": "https://schema.org", "@type": "Service", "name": "Unity Development Services", "description": pageDescription, "url": pageCanonical, "provider": {"@type": "ProfessionalService", "name": "Interactive Solutions", "url": "https://interactivesolutions.hr/"}};

block main

    main(role="main" id="main")

        section(class="page-hero")
            div(class="page-hero-inner")
                ul(class="breadcrumbs")
                    li: a(href="/") Home
                    li Services
                h1 Unity development services
                p.
                    Senior Unity support for teams that need architecture, gameplay systems,
                    multiplayer, optimization or help shipping a project — delivered hands-on.

        section(class="page-section")
            div(class="section-inner")

                div(class="section-heading")
                    h2(class="section-title") Senior Unity support where it matters most

                +services-grid()

        section(class="page-section")
            div(class="section-inner")
                p(class="section-eyebrow") How an engagement starts
                h2(class="section-title") From a short message to a defined next step
                div(class="prose")
                    p.
                        You do not need a technical specification to get started. The first goal is always
                        to identify the smallest credible path to a useful result.
                    ul
                        li Tell me the goal, the audience and the constraints in ordinary language.
                        li I review the situation and recommend the smallest sensible first scope.
                        li You receive assumptions, deliverables, exclusions, schedule and price in writing.
                        li Work proceeds in visible milestones with regular playable or reviewable builds.
                        li Delivery includes handover, documentation and options for continued support.
                div(class="callout")
                    h3(class="callout-title") Unity Project Health Check
                    p(class="callout-text").
                        A focused starting engagement for existing projects: a kickoff call, a review of
                        agreed code and project areas, prioritized technical findings, and recommended next
                        steps. It can be followed by hands-on implementation if useful.

                div(class="callout")
                    h3(class="callout-title") Have an idea, not a technical brief?
                    p(class="callout-text").
                        Start with the outcome in ordinary language. You do not need to know whether the
                        right first step is Unity, browser technology or a larger project team.
                    p(class="callout-text").
                        Examples include a mobile game for a campaign, a 3D configurator or editor, or an
                        educational interactive product. The first engagement can turn that idea into a
                        credible scope, team shape and next step.

        +pricing-section()

        section(class="page-section")
            div(class="section-inner")
                +cta-band('Tell me where your Unity project is stuck.', '/contact/', 'Discuss Your Unity Project')
